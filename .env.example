# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=16000

# --- Jira Cloud ---
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@yourcompany.com
JIRA_API_TOKEN=
# Leave empty if the bot and the human reviewer use the same Jira account (solo POC)
JIRA_BOT_ACCOUNT_ID=
# Optional custom field id that overrides the repo per ticket, e.g. customfield_10101
JIRA_FIELD_TARGET_REPO=
# Shared secret appended to the webhook URL (?token=...)
WEBHOOK_TOKEN=change-me

# --- GitHub (fine-grained PAT for the POC; GitHub App in production) ---
GITHUB_TOKEN=
GIT_AUTHOR_NAME=AI SDLC Bot
GIT_AUTHOR_EMAIL=ai-sdlc-bot@example.com

# --- Runtime ---
WORK_DIR=./workspaces
STATE_DB=./state.db

# --- Salesforce DX MCP server ---
MCP_TOOLSETS=orgs,metadata,data,testing
MCP_EXTRA_ARGS=--allow-non-ga-tools

# --- Guardrails ---
COVERAGE_TARGET=85
MAX_QUESTION_ROUNDS=2
MAX_DESIGN_REVISIONS=3
MAX_HEAL_ATTEMPTS=5
REQUIRED_TICKET_SECTIONS=Business Goal,Acceptance Criteria
DELETE_SCRATCH_ON_DONE=false

# --- Salesforce Dev Hub auth (optional JWT; otherwise run `sf org login web` once) ---
SF_DEVHUB_ALIAS=devhub
SF_JWT_CLIENT_ID=
SF_JWT_KEY_FILE=
SF_JWT_USERNAME=
SF_JWT_INSTANCE_URL=https://login.salesforce.com
